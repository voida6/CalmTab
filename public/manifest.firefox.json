{
  "manifest_version": 3,
  "name": "CalmTab",
  "version": "0.5.0",
  "description": "A calm, customizable Material You new-tab dashboard.",
  "browser_specific_settings": {
    "gecko": { "id": "calmtab@voida6.github.io", "strict_min_version": "128.0" }
  },
  "chrome_url_overrides": { "newtab": "index.html" },
  "permissions": ["storage", "unlimitedStorage", "geolocation"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.coingecko.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
