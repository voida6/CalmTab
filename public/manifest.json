{
  "manifest_version": 3,
  "name": "CalmTab",
  "version": "0.1.0",
  "description": "A calm, customizable Material You new-tab dashboard.",
  "chrome_url_overrides": { "newtab": "index.html" },
  "permissions": ["storage", "geolocation"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
