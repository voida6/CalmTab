{
  "manifest_version": 3,
  "name": "CalmTab",
  "description": "A calm, customizable Material You new-tab dashboard.",
  "chrome_url_overrides": { "newtab": "index.html" },
  "permissions": ["storage", "unlimitedStorage", "geolocation", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.coingecko.com/*",
    "https://api.frankfurter.app/*"
  ],
  "commands": {
    "open-launcher": {
      "suggested_key": { "default": "Alt+K" },
      "description": "Open the CalmTab launcher on the current page"
    },
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Save the current page as a CalmTab shortcut"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["launcher.html", "assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
